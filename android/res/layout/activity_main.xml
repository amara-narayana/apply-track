<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="ApplyTrack Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPLY TRACK"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tv_vault_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● SQLite Vault • Offline"
                android:textSize="11sp"
                android:textColor="#2dd4bf" />
        </LinearLayout>

        <!-- Pin to Home Screen Button -->
        <Button
            android:id="@+id/btn_pin_home"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="📲 Add to Home"
            android:textSize="11sp"
            android:textColor="#2dd4bf"
            android:background="@drawable/glass_btn_secondary"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textAllCaps="false" />

        <!-- Theme Toggle Button -->
        <Button
            android:id="@+id/btn_theme_toggle"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="☀️"
            android:textSize="14sp"
            android:background="@drawable/glass_btn_secondary" />
    </LinearLayout>

    <!-- Search Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/glass_input_bg"
            android:hint="🔍 Search company, role, location..."
            android:textColorHint="#94a3b8"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- Metrics Summary Strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card: Total -->
            <LinearLayout
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_dark"
                android:padding="10dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL"
                    android:textSize="10sp"
                    android:textColor="#94a3b8"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_metric_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff" />
            </LinearLayout>

            <!-- Card: Applied -->
            <LinearLayout
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_dark"
                android:padding="10dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPLIED"
                    android:textSize="10sp"
                    android:textColor="#2dd4bf"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_metric_applied"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2dd4bf" />
            </LinearLayout>

            <!-- Card: Interviews -->
            <LinearLayout
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_dark"
                android:padding="10dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTERVIEW"
                    android:textSize="10sp"
                    android:textColor="#a855f7"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_metric_interviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#a855f7" />
            </LinearLayout>

            <!-- Card: Offers -->
            <LinearLayout
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_dark"
                android:padding="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFERS"
                    android:textSize="10sp"
                    android:textColor="#10b981"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_metric_offers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#10b981" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Stage Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/ll_filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="All"
                android:textSize="12sp"
                android:textColor="#0a0f1d"
                android:background="@drawable/chip_active"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_applied"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Applied"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_screening"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Screening"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_interview"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Interview"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_offer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Offer"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_rejected"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Rejected"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Navigation Tabs Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="#151e2e"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tab_applications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Applications"
            android:textColor="#2dd4bf"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tab_kanban"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Kanban Board"
            android:textColor="#94a3b8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tab_vault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SQLite Vault"
            android:textColor="#94a3b8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- VIEW 1: Applications List -->
        <ScrollView
            android:id="@+id/view_applications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ll_applications_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Empty state placeholder -->
                <LinearLayout
                    android:id="@+id/ll_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/glass_card_dark"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💼"
                        android:textSize="44sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero Applications Recorded"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No fake or synthetic data. Tap '+ New Application' below to track your first job."
                        android:textColor="#94a3b8"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Dynamic Cards Added Here -->
                <LinearLayout
                    android:id="@+id/ll_card_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- VIEW 2: Kanban Board -->
        <ScrollView
            android:id="@+id/view_kanban"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:id="@+id/ll_kanban_columns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp" />
            </HorizontalScrollView>
        </ScrollView>

        <!-- VIEW 3: SQLite Vault & Storage Info -->
        <ScrollView
            android:id="@+id/view_vault"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/glass_card_dark"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Android Internal SQLite Storage"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_vault_full_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="/data/data/com.amara.applytrack/databases/jobtracker.db"
                        android:textColor="#2dd4bf"
                        android:textSize="12sp"
                        android:background="@drawable/glass_input_bg"
                        android:padding="10dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tv_vault_db_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Database Size: 12.0 KB"
                        android:textColor="#94a3b8"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SQLite 3.x with Android SQLiteOpenHelper. Zero internet permissions required."
                        android:textColor="#64748b"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Data Maintenance Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/glass_card_dark"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Export &amp; Sharing"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_export_csv"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Export &amp; Share CSV (Gmail, Drive, WhatsApp)"
                        android:textColor="#0a0f1d"
                        android:background="@drawable/glass_btn_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btn_clear_db"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Reset Database (Delete All Records)"
                        android:textColor="#f43f5e"
                        android:background="@drawable/glass_btn_secondary"
                        android:textSize="13sp"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Action Bar / Add Application Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#0d1424">

        <Button
            android:id="@+id/btn_new_app"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ New Application"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0a0f1d"
            android:background="@drawable/glass_btn_primary"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
