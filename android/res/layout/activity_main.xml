<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@drawable/bg_dark">

    <!-- Top App Bar (Compact, Responsive, No Overflow) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="ApplyTrack Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPLY TRACK"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:letterSpacing="0.03"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_vault_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● SQLite Vault • Offline"
                android:textSize="10sp"
                android:textColor="#2dd4bf"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Compact Add to Home Button -->
        <Button
            android:id="@+id/btn_pin_home"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:text="📲"
            android:textSize="14sp"
            android:background="@drawable/glass_btn_secondary"
            android:padding="0dp"
            android:gravity="center"
            android:contentDescription="Add to Home Screen" />

        <!-- Compact Theme Toggle Button -->
        <Button
            android:id="@+id/btn_theme_toggle"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:text="☀️"
            android:textSize="13sp"
            android:background="@drawable/glass_btn_secondary"
            android:padding="0dp"
            android:gravity="center"
            android:contentDescription="Toggle Dark/Light Theme" />
    </LinearLayout>

    <!-- Search Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/glass_input_bg"
            android:hint="🔍 Search company, role, location..."
            android:textColorHint="#94a3b8"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- Responsive 4-Column Metrics Bar (Fits 100% on ANY Screen Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <!-- Card 1: Total -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/glass_card_dark"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_margin="2dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textSize="9sp"
                android:textColor="#94a3b8"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_metric_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#ffffff" />
        </LinearLayout>

        <!-- Card 2: Applied -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/glass_card_dark"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_margin="2dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPLIED"
                android:textSize="9sp"
                android:textColor="#2dd4bf"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_metric_applied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#2dd4bf" />
        </LinearLayout>

        <!-- Card 3: Interviews -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/glass_card_dark"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_margin="2dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERVIEW"
                android:textSize="9sp"
                android:textColor="#a855f7"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_metric_interviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#a855f7" />
        </LinearLayout>

        <!-- Card 4: Offers -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/glass_card_dark"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_margin="2dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFERS"
                android:textSize="9sp"
                android:textColor="#10b981"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_metric_offers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#10b981" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stage Filter Chips Strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/ll_filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="All"
                android:textSize="11sp"
                android:textColor="#0a0f1d"
                android:background="@drawable/chip_active"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_applied"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Applied"
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_screening"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Screening"
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_interview"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Interview"
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_offer"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Offer"
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/chip_rejected"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Rejected"
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:background="@drawable/chip_inactive"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Navigation Tabs Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="#151e2e">

        <TextView
            android:id="@+id/tab_applications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Applications"
            android:textColor="#2dd4bf"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tab_kanban"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Kanban"
            android:textColor="#94a3b8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tab_vault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Vault"
            android:textColor="#94a3b8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Content Container (Expands flexibly to fill available vertical space) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- VIEW 1: Applications List -->
        <ScrollView
            android:id="@+id/view_applications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ll_applications_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Empty state placeholder -->
                <LinearLayout
                    android:id="@+id/ll_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/glass_card_dark"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💼"
                        android:textSize="36sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero Applications Recorded"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No fake data. Tap '+ New Application' below to track your first job."
                        android:textColor="#94a3b8"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Dynamic Cards Added Here -->
                <LinearLayout
                    android:id="@+id/ll_card_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- VIEW 2: Kanban Board -->
        <ScrollView
            android:id="@+id/view_kanban"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:id="@+id/ll_kanban_columns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp" />
            </HorizontalScrollView>
        </ScrollView>

        <!-- VIEW 3: SQLite Vault & Storage Info -->
        <ScrollView
            android:id="@+id/view_vault"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/glass_card_dark"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Android Internal SQLite Storage"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_vault_full_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="/data/data/com.amara.applytrack/databases/jobtracker.db"
                        android:textColor="#2dd4bf"
                        android:textSize="11sp"
                        android:background="@drawable/glass_input_bg"
                        android:padding="8dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tv_vault_db_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Database Size: 12.0 KB"
                        android:textColor="#94a3b8"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SQLite 3.x with Android SQLiteOpenHelper. Fully offline."
                        android:textColor="#64748b"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Data Maintenance Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/glass_card_dark"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Export &amp; Sharing"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btn_export_csv"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Export &amp; Share CSV"
                        android:textColor="#0a0f1d"
                        android:background="@drawable/glass_btn_primary"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btn_clear_db"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Reset Database (Delete All Records)"
                        android:textColor="#f43f5e"
                        android:background="@drawable/glass_btn_secondary"
                        android:textSize="12sp"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Action Bar (Fixed, cleanly padded above system navigation bar) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#0d1424">

        <Button
            android:id="@+id/btn_new_app"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="+ New Application"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0a0f1d"
            android:background="@drawable/glass_btn_primary"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
