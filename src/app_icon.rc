            VALUE "OriginalFilename", "ApplyTrack.exe"
            VALUE "ProductName", "APPLY TRACK"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
